# Скопируйте в .env и поменяйте пароли. Файл .env в репозиторий НЕ попадает (.gitignore).
# Пароль базы — только буквы и цифры: он подставляется в строку подключения Airflow.
POSTGRES_USER=antifraud
POSTGRES_PASSWORD=change_me
# неделя 6: вход в веб-интерфейс Airflow (пользователь admin) и модель для текста отчёта
AIRFLOW_ADMIN_PASSWORD=admin
LLM_MODEL=qwen2.5:3b
